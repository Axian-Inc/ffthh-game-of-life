{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/instructions/open-model-tools.md"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (studio1 LAN)",
      "options": {
        "baseURL": "http://studio1.axian.com:11434/v1",
        "timeout": false,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen3.5 9B (32K)",
          "family": "qwen3.5",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.6:27b-coding-mxfp8": {
          "name": "Qwen3.6 27B Coding MXFP8",
          "family": "qwen3.6",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "attachment": true,
          "limit": {
            "context": 262144,
            "output": 81920
          }
        }
      }
    }
  }
}
